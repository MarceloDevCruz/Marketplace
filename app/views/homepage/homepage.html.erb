<div class="min-h-screen flex flex-col bg-gradient-to-b from-[#0b1f39] via-[#113056] to-[#16406f] text-white">
  <header class="flex-1 flex items-center">
    <div class="mx-auto max-w-7xl px-6 grid md:grid-cols-2 gap-12">
      <div class="flex flex-col justify-center">
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight">
          Conecte-se ao <span class="text-blue-300">melhor</span> mercado digital
        </h1>
        <p class="mt-6 text-lg text-blue-100 max-w-prose">
          Descubra produtos, serviços e oportunidades em um ecossistema moderno, seguro e rápido.
          Junte-se hoje e comece a explorar.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <%= link_to "Começar agora", new_user_registration_path,
            class: "px-6 py-3 rounded-lg font-semibold bg-blue-500 hover:bg-blue-400 text-white shadow shadow-blue-900/50 transition" %>
          <%= link_to "Já tenho conta", new_user_session_path,
            class: "px-6 py-3 rounded-lg font-semibold bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur transition" %>
        </div>
        <div class="mt-8 flex items-center gap-6 text-xs text-blue-200">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-blue-400 animate-pulse"></span>
            Segurança avançada
          </div>
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-blue-400 animate-pulse"></span>
            Performance otimizada
          </div>
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-blue-400 animate-pulse"></span>
            Comunidade ativa
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="absolute inset-0 -m-8 rounded-3xl bg-gradient-to-tr from-blue-900/60 via-blue-700/40 to-blue-500/30 blur-2xl opacity-70"></div>
        <div class="relative rounded-2xl border border-white/10 bg-white/5 backdrop-blur p-8 flex flex-col gap-6">
          <h2 class="text-xl font-semibold">Vantagens</h2>
          <ul class="space-y-4 text-sm text-blue-100">
            <li class="flex gap-3">
              <span class="mt-1 h-5 w-5 flex items-center justify-center rounded-full bg-blue-500/20 text-blue-300 text-xs font-bold">1</span>
              Painel intuitivo para gerenciar seus itens.
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-5 w-5 flex items-center justify-center rounded-full bg-blue-500/20 text-blue-300 text-xs font-bold">2</span>
              Busca avançada e filtros inteligentes.
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-5 w-5 flex items-center justify-center rounded-full bg-blue-500/20 text-blue-300 text-xs font-bold">3</span>
              Integração com ferramentas modernas.
            </li>
          </ul>
          <%= link_to "Explorar", new_user_registration_path,
            class: "mt-2 inline-flex items-center justify-center rounded-md bg-blue-500 hover:bg-blue-400 px-5 py-2 text-sm font-semibold shadow shadow-blue-900/40 transition" %>
        </div>
      </div>
    </div>
  </header>

</div>