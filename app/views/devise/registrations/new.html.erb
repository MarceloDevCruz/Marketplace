<% content_for :title, "Registrar" %>
<div class="mt-8 md:mt-12 px-6 sm:px-8 lg:px-10 py-10 md:py-14 flex justify-center">
  <div class="relative w-[1640px] sm:w-[1680px] md:w-[1620px]">
    <div class="absolute -inset-2 rounded-3xl bg-gradient-to-tr from-blue-900/60 via-blue-700/40 to-blue-500/30 blur-2xl opacity-70"></div>
    <div class="relative rounded-2xl border border-white/10 bg-white/5 backdrop-blur-xl shadow-xl shadow-blue-950/40">
      <div class="px-px py-8 md:px-8 md:py-10">
        <h1 class="text-2xl md:text-3xl font-bold text-white tracking-tight">Crie sua conta</h1>
        <p class="mt-2 text-sm text-blue-200">Junte-se ao marketplace e comece a explorar hoje mesmo.</p>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mt-8 space-y-6">
            <div>
              <%= f.label :email, class: "block text-sm font-medium text-blue-100" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-lg bg-[#0b1f39]/50 border border-white/15 px-4 py-2.5 text-white placeholder-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500/70 focus:border-blue-400 transition" %>
            </div>

            <div>
              <div class="flex items-center justify-between">
                <%= f.label :password, class: "block text-sm font-medium text-blue-100" %>
                <% if @minimum_password_length %>
                  <em class="text-xs text-blue-300">(<%= @minimum_password_length %> caracteres mínimo)</em>
                <% end %>
              </div>
              <%= f.password_field :password, autocomplete: "new-password", class: "mt-1 block w-full rounded-lg bg-[#0b1f39]/50 border border-white/15 px-4 py-2.5 text-white placeholder-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500/70 focus:border-blue-400 transition" %>
            </div>

            <div>
              <%= f.label :password_confirmation, class: "block text-sm font-medium text-blue-100" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 block w-full rounded-lg bg-[#0b1f39]/50 border border-white/15 px-4 py-2.5 text-white placeholder-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500/70 focus:border-blue-400 transition" %>
            </div>
          </div>

          <div class="mt-8 flex flex-col gap-4">
            <%= f.submit "Registrar", class: "inline-flex justify-center rounded-lg bg-blue-600 hover:bg-blue-500 active:bg-blue-500/90 px-6 py-3 text-sm font-semibold text-white shadow shadow-blue-900/40 ring-1 ring-inset ring-white/10 focus:outline-none focus:ring-2 focus:ring-blue-400 transition" %>
            <%= link_to "Já tenho conta", new_session_path(resource_name), class: "text-center rounded-lg border border-white/15 bg-white/10 hover:bg-white/15 active:bg-white/20 px-6 py-3 text-sm font-medium text-white backdrop-blur focus:outline-none focus:ring-2 focus:ring-blue-400 transition" %>
          </div>
        <% end %>

        <div class="mt-8 text-center text-xs text-blue-300">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
