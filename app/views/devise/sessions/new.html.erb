<% content_for :title, "Login" %>
<div class="mt-8 md:mt-12 px-4 sm:px-6 md:px-8 py-10 md:py-14 flex justify-center w-full" style="max-width: 900px; margin: 0 auto;">
  <div class="relative w-full max-w-sm sm:max-w-md md:max-w-lg lg:max-w-2xl xl:max-w-[900px]">
    <div class="absolute -inset-2 rounded-3xl bg-gradient-to-tr from-blue-900/60 via-blue-700/40 to-blue-500/30 blur-2xl opacity-70"></div>
    <div class="relative rounded-2xl border border-white/10 bg-white/5 backdrop-blur-xl shadow-xl shadow-blue-950/40">
      <div class="px-4 sm:px-6 py-8 md:px-8 md:py-10">
        <h1 class="text-2xl md:text-3xl font-bold text-white tracking-tight">Acesse sua conta</h1>
        <p class="mt-2 text-sm text-blue-200">Entre para gerenciar seus produtos e explorar o marketplace.</p>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mt-8 space-y-6">
            <div>
              <%= f.label :email, class: "block text-sm font-medium text-blue-100" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-lg bg-[#0b1f39]/50 border border-white/15 px-4 py-2.5 text-white placeholder-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500/70 focus:border-blue-400 transition" %>
            </div>

            <div>
              <div class="flex items-center justify-between">
                <%= f.label :password, class: "block text-sm font-medium text-blue-100" %>
                <%= link_to "Esqueceu a senha?", new_password_path(resource_name), class: "text-xs font-medium text-blue-300 hover:text-blue-200 transition" %>
              </div>
              <%= f.password_field :password, autocomplete: "current-password", class: "mt-1 block w-full rounded-lg bg-[#0b1f39]/50 border border-white/15 px-4 py-2.5 text-white placeholder-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500/70 focus:border-blue-400 transition" %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="flex items-center gap-2">
                <%= f.check_box :remember_me, class: "rounded border-white/30 bg-[#0b1f39]/70 text-blue-500 focus:ring-blue-500 focus:ring-offset-0" %>
                <%= f.label :remember_me, class: "text-xs text-blue-200" %>
              </div>
            <% end %>
          </div>

          <div class="mt-8 flex flex-col gap-4">
            <%= f.submit "Entrar", class: "inline-flex justify-center rounded-lg bg-blue-600 hover:bg-blue-500 active:bg-blue-500/90 px-6 py-3 text-sm font-semibold text-white shadow shadow-blue-900/40 ring-1 ring-inset ring-white/10 focus:outline-none focus:ring-2 focus:ring-blue-400 transition" %>
            <%= link_to "Criar nova conta", new_registration_path(resource_name), class: "text-center rounded-lg border border-white/15 bg-white/10 hover:bg-white/15 active:bg-white/20 px-6 py-3 text-sm font-medium text-white backdrop-blur focus:outline-none focus:ring-2 focus:ring-blue-400 transition" %>
          </div>
        <% end %>

        <div class="mt-8 text-center text-xs text-blue-300">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
